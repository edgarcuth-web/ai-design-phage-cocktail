{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edgarcuth-web/ai-design-phage-cocktail/main/schemas/feature-artifact-v1.schema.json",
  "title": "FeatureArtifact v1",
  "description": "Provenance manifest for outputs of a versioned computational feature analysis. It does not establish biological validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "created_at",
    "feature_set",
    "subject",
    "analysis",
    "outputs",
    "status",
    "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "feature_set": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "primary"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "sequence_sha256",
        "input_file_sha256",
        "length_bases",
        "contigs"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "host_genome",
            "phage_sequence"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "length_bases": {
          "type": "integer",
          "minimum": 1
        },
        "contigs": {
          "type": "integer",
          "minimum": 1
        },
        "accession": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sequence_registry_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_registry_file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "started_at",
        "finished_at",
        "parameters",
        "parameters_sha256",
        "reference_data"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "parameters": {
          "type": "object"
        },
        "parameters_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/referenceSnapshot"
          }
        },
        "environment": {
          "type": "object"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "container_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "referenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "format",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "raw",
            "log",
            "auxiliary"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
