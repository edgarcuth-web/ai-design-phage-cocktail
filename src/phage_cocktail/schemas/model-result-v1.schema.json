{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edgarcuth-web/ai-design-phage-cocktail/main/schemas/model-result-v1.schema.json",
  "title": "ModelResult v1",
  "description": "Content-addressed external model output. record_id must equal result_id. request_sha256 must equal the exact ModelRequest content_sha256. The lab remains authoritative for cross-record lineage and requested-target admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_sha256",
    "schema_version",
    "record_id",
    "result_id",
    "request_id",
    "request_sha256",
    "host_state",
    "phage_profile_id",
    "phage_profile_sha256",
    "probabilities",
    "mechanistic_explanation",
    "limitations",
    "producer",
    "predicted_at"
  ],
  "properties": {
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must equal result_id; enforced by the lab's semantic contract validator."
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_state": {
      "$ref": "#/$defs/hostStateReference"
    },
    "phage_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "phage_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adsorption",
        "productive_infection",
        "resistance_emergence"
      ],
      "properties": {
        "adsorption": {
          "$ref": "#/$defs/probabilityEstimate"
        },
        "productive_infection": {
          "$ref": "#/$defs/probabilityEstimate"
        },
        "resistance_emergence": {
          "$ref": "#/$defs/probabilityEstimate"
        }
      }
    },
    "mechanistic_explanation": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer": {
      "$ref": "#/$defs/predictionProducer"
    },
    "predicted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "hostStateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "content_sha256",
        "host_profile_id",
        "host_genome_sha256",
        "as_of"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "host_genome_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "probabilityEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "probability",
        "uncertainty_lower",
        "uncertainty_upper",
        "uncertainty_method"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "estimated",
            "not_estimated"
          ]
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty_lower": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty_upper": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_estimated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "probability": {
                "type": "null"
              },
              "uncertainty_lower": {
                "type": "null"
              },
              "uncertainty_upper": {
                "type": "null"
              },
              "uncertainty_method": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "estimated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "uncertainty_lower": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "uncertainty_upper": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "uncertainty_method": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "The uncertainty interval must contain probability (uncertainty_lower <= probability <= uncertainty_upper); the lab semantic validator enforces ordering."
          }
        }
      ]
    },
    "predictionProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "parameters",
        "artifact_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "probabilities": {
            "properties": {
              "adsorption": {
                "properties": {
                  "status": {
                    "const": "estimated"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "adsorption"
            ]
          }
        },
        "required": [
          "probabilities"
        ]
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "probabilities": {
            "properties": {
              "productive_infection": {
                "properties": {
                  "status": {
                    "const": "estimated"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "productive_infection"
            ]
          }
        },
        "required": [
          "probabilities"
        ]
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "probabilities": {
            "properties": {
              "resistance_emergence": {
                "properties": {
                  "status": {
                    "const": "estimated"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "resistance_emergence"
            ]
          }
        },
        "required": [
          "probabilities"
        ]
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
