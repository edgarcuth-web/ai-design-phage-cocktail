{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edgarcuth-web/ai-design-phage-cocktail/main/schemas/resource-registry-v1.schema.json",
  "title": "Local Model Resource Registry v1",
  "description": "An explicit local index for resolving exact HostState and PhageProfile records. Availability is an operational status, not evidence of biological validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceEntry"
      }
    }
  },
  "$defs": {
    "resourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resource_id",
        "content_sha256",
        "file_sha256",
        "path",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "host_state",
            "phage_profile"
          ]
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "withdrawn"
          ]
        }
      }
    }
  }
}
